# EditorConfig — mesma formatação básica em qualquer editor/IDE da equipe.
# Evita diffs "fantasmas" de espaços, tabulação e quebras de linha.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
