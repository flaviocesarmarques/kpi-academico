{
  "title": "KPI Acadêmico — API",
  "uid": "kpi-academico-api",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "kpi-academico",
    "slo"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Ambiente",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total, namespace)",
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições por segundo (por rota)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rota) (rate(http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{rota}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taxa de erro 5xx (SLO: 0,5%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kpi:taxa_erro:5m{namespace=\"$namespace\"}",
          "legendFormat": "erro"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência p95 (SLO: 500 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kpi:latencia_p95:5m{namespace=\"$namespace\"}",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Medições de KPI registradas (por curso)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (curso) (increase(kpi_medicoes_registradas_total{namespace=\"$namespace\"}[1h]))",
          "legendFormat": "{{curso}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Versão em execução",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^versao$/"
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (versao) (kpi_build_info{namespace=\"$namespace\"})",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
