# =============================================================================
# Variáveis de ambiente — copie para .env (que NÃO é versionado):
#   cp .env.example .env
# Em Kubernetes, os valores vêm de ConfigMap (não sensíveis) e Secret (sensíveis).
# =============================================================================
KPI_AMBIENTE=dev
KPI_LOG_LEVEL=INFO

# PostgreSQL do docker-compose. Para SQLite local: sqlite:///./kpi.db
KPI_DATABASE_URL=postgresql+psycopg://kpi:kpi-dev@localhost:5432/kpi
POSTGRES_PASSWORD=kpi-dev

# Chave para rotas de escrita (POST). Gere uma forte: openssl rand -hex 32
KPI_API_KEY=troque-esta-chave

# Semáforo de metas (% de atingimento)
KPI_LIMITE_VERDE=100
KPI_LIMITE_AMARELO=85

# Feature flags: valor local (usado quando o Unleash não está configurado)
KPI_FLAG_PAINEL_TENDENCIA=false
# KPI_UNLEASH_URL=http://localhost:4242/api
# KPI_UNLEASH_TOKEN=default:development.troque

# Traces OpenTelemetry (descomente quando houver coletor/Tempo)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
